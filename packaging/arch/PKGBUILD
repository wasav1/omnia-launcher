# Maintainer: wasav1
# Paquete dividido: omnia-core (servicio y API), omnia-ui (estantería) y omnia-kde (integración con KDE Plasma).
pkgbase=omnia-launcher
pkgname=(omnia-core omnia-ui omnia-kde)
pkgver=0.1.0
pkgrel=1
pkgdesc="Biblioteca de juegos unificada y escritorio de juegos para CachyOS y KDE Plasma"
arch=(any)
url="https://github.com/wasav1/omnia-launcher"
license=('GPL-3.0-or-later')       # recomendada; decisión abierta, confirmar antes de publicar
makedepends=(python-build python-installer python-setuptools python-wheel)
source=("$pkgbase-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')                # sustituir con `updpkgsums` al publicar una versión

build() {
  cd "$pkgbase-$pkgver"
  python -m build --wheel --no-isolation
}

package_omnia-core() {
  pkgdesc="Núcleo de Omnia: biblioteca de juegos, API local, arte y mando"
  depends=(python systemd)
  optdepends=('steam: juegos de Steam'
              'lutris: juegos de Lutris'
              'heroic-games-launcher-bin: juegos de Epic, GOG y Amazon'
              'umu-launcher: juegos de Windows con Proton'
              'mangohud: indicadores de rendimiento')
  cd "$pkgbase-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/systemd/omnia.service "$pkgdir/usr/lib/systemd/user/omnia.service"
}

package_omnia-ui() {
  pkgdesc="Estantería de Omnia: escritorio de juegos en capa de fondo (QML)"
  depends=(omnia-core qt6-declarative qt6-wayland layer-shell-qt)
  cd "$pkgbase-$pkgver"
  install -Dm755 ui/omnia-ui "$pkgdir/usr/bin/omnia-ui"
  install -d "$pkgdir/usr/share/omnia/ui"
  cp -r ui/qml "$pkgdir/usr/share/omnia/ui/"
  install -Dm644 packaging/systemd/omnia-ui.service "$pkgdir/usr/lib/systemd/user/omnia-ui.service"
}

package_omnia-kde() {
  pkgdesc="Integración de Omnia con KDE Plasma: Win+D, vigilante de ventanas y primer arranque"
  depends=(omnia-ui kwin kdialog python-gobject)
  cd "$pkgbase-$pkgver"
  for s in omnia-showdesktop omnia-watch; do
    install -d "$pkgdir/usr/share/kwin/scripts/$s"
    cp -r "kwin/$s/." "$pkgdir/usr/share/kwin/scripts/$s/"
  done
  install -Dm644 packaging/xdg/omnia-first-run.desktop "$pkgdir/etc/xdg/autostart/omnia-first-run.desktop"
}
