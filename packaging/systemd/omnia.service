[Unit]
Description=Omnia: biblioteca unificada de juegos
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/omnia-core
Restart=on-failure
RestartSec=3
# Los juegos van en scopes propios (systemd-run), no dependen de este servicio.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK: los juegos lanzados por Omnia heredan este filtro y Wine/Proton lo necesita (p. ej. Minecraft Bedrock
# con BedrockOnLinux se queda colgado al arrancar sin él).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
